{
  "name": "@cherrystudio/ai-shared-core",
  "version": "0.1.0",
  "description": "AI1 shared core: API contracts, data models, sync client, and agent-protocol types for desktop, Android, iOS, and backend",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false"
  },
  "dependencies": {
    "@cherrystudio/agent-team": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
